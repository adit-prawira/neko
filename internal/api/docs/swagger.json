{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Local-first vector database REST API. Brute-force KNN search over raw f32 vectors, with collection-scoped inserts and metadata.",
        "title": "Neko API",
        "contact": {},
        "version": "0.1.0"
    },
    "host": "localhost:3434",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns ok if the engine has been initialised.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Liveness check",
                "responses": {
                    "200": {
                        "description": "Neko Server is Healthy",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "503": {
                        "description": "engine not initialised",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        },
        "/v1/collections": {
            "get": {
                "description": "Returns all collections with their dimension, metric, and vector count.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "collections"
                ],
                "summary": "List collections",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.CollectionsResponseHttpDTO"
                        }
                    }
                }
            },
            "post": {
                "description": "Creates a new named collection with a fixed dimension and distance metric.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "collections"
                ],
                "summary": "Create a collection",
                "parameters": [
                    {
                        "description": "Collection config",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.CreateCollectionRequestHttpDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_api.CreateCollectionResponseHttpDTO"
                        }
                    },
                    "400": {
                        "description": "HAIRBALL_INVALID_NAME / HAIRBALL_INVALID_METRIC",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    },
                    "409": {
                        "description": "HAIRBALL_ALREADY_EXISTS",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        },
        "/v1/collections/{name}": {
            "get": {
                "description": "Returns stats for a single collection.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "collections"
                ],
                "summary": "Get collection info",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.CollectionResponseHttpDTO"
                        }
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            },
            "delete": {
                "description": "Removes a collection and its data directory.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "collections"
                ],
                "summary": "Drop a collection",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        },
        "/v1/collections/{name}/search": {
            "post": {
                "description": "Brute-force KNN over the collection's vectors. Returns the top-k results sorted by score.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Search top-K nearest neighbors",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Search query",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.SearchQueryParamsHttpDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.SearchResponseHttpDTO"
                        }
                    },
                    "400": {
                        "description": "HAIRBALL_DIM_MISMATCH / HAIRBALL_DIM_TOO_SMALL",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        },
        "/v1/collections/{name}/vectors": {
            "post": {
                "description": "Inserts a vector with a given ID. Fails if the ID already exists.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Insert a single vector",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Vector to insert (id is in the path; do not include in body)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.UpsertVectorHttpDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_api.UpsertVectorResponseHttpDTO"
                        }
                    },
                    "400": {
                        "description": "HAIRBALL_DIM_MISMATCH / HAIRBALL_DIM_TOO_SMALL",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    },
                    "409": {
                        "description": "HAIRBALL_ALREADY_EXISTS",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        },
        "/v1/collections/{name}/vectors/batch": {
            "post": {
                "description": "Inserts up to 10,000 vectors in one call. The request body is a bare JSON array (no wrapping object). Each element must include `id` and `vector`. All-or-nothing on dim and id validation.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Batch insert vectors",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Array of vectors to insert (max 10,000)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/internal_api.UpsertVectorHttpDTO"
                            }
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/internal_api.InsertManyVectorResponseHttpDTO"
                        }
                    },
                    "400": {
                        "description": "HAIRBALL_INVALID_NAME / HAIRBALL_DIM_MISMATCH",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        },
        "/v1/collections/{name}/vectors/{id}": {
            "get": {
                "description": "Returns the vector and its raw metadata JSON string.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Get a vector by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Vector ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_api.GetVectorResponseHttpDTO"
                        }
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            },
            "put": {
                "description": "Insert-or-update by ID. Returns 201 if the vector was created, 200 if an existing vector was replaced.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Insert or update a vector",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Vector ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Vector data (id is in the path; do not include in body)",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_api.UpsertVectorHttpDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Vector updated",
                        "schema": {
                            "$ref": "#/definitions/internal_api.UpsertVectorResponseHttpDTO"
                        }
                    },
                    "201": {
                        "description": "Vector created",
                        "schema": {
                            "$ref": "#/definitions/internal_api.UpsertVectorResponseHttpDTO"
                        }
                    },
                    "400": {
                        "description": "HAIRBALL_DIM_MISMATCH / HAIRBALL_DIM_TOO_SMALL",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            },
            "delete": {
                "description": "Removes a vector by ID.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vectors"
                ],
                "summary": "Delete a vector",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Collection name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Vector ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "404": {
                        "description": "HAIRBALL_NOT_FOUND",
                        "schema": {
                            "$ref": "#/definitions/internal_api.APIError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_api.APIError": {
            "type": "object",
            "properties": {
                "error": {
                    "$ref": "#/definitions/internal_api.HairballDetail"
                }
            }
        },
        "internal_api.CollectionResponseHttpDTO": {
            "type": "object",
            "properties": {
                "dim": {
                    "type": "integer"
                },
                "metric": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "storage_bytes": {
                    "type": "integer"
                },
                "vector_count": {
                    "type": "integer"
                }
            }
        },
        "internal_api.CollectionsResponseHttpDTO": {
            "type": "object",
            "properties": {
                "collections": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_api.CollectionResponseHttpDTO"
                    }
                }
            }
        },
        "internal_api.CreateCollectionRequestHttpDTO": {
            "type": "object",
            "properties": {
                "dim": {
                    "type": "integer"
                },
                "metric": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "internal_api.CreateCollectionResponseHttpDTO": {
            "type": "object",
            "properties": {
                "dim": {
                    "type": "integer"
                },
                "metric": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "internal_api.GetVectorResponseHttpDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "metadata": {
                    "type": "string"
                },
                "vector": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "internal_api.HairballDetail": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "internal_api.InsertManyVectorResponseHttpDTO": {
            "type": "object",
            "properties": {
                "dim": {
                    "type": "integer"
                },
                "ids": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "inserted": {
                    "type": "integer"
                }
            }
        },
        "internal_api.ScoredResultHttpDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "score": {
                    "type": "number"
                }
            }
        },
        "internal_api.SearchQueryParamsHttpDTO": {
            "type": "object",
            "properties": {
                "filter": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "top_k": {
                    "type": "integer"
                },
                "vector": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "internal_api.SearchResponseHttpDTO": {
            "type": "object",
            "properties": {
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_api.ScoredResultHttpDTO"
                    }
                }
            }
        },
        "internal_api.UpsertVectorHttpDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "metadata": {
                    "type": "string"
                },
                "vector": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            }
        },
        "internal_api.UpsertVectorResponseHttpDTO": {
            "type": "object",
            "properties": {
                "dim": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                }
            }
        }
    }
}